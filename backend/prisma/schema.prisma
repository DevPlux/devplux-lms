// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  domains     TenantDomain[]
  memberships Membership[]
  sessions    AuthSession[]
  profile     TenantProfile?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  auditLogs   AuditLog[]
  invitations InstituteInvitation[]
}

model TenantDomain {
  id         String    @id @default(uuid())
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum InstituteRole {
  INSTITUTE_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACADEMIC_MANAGER
  ACCOUNTANT
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  isActive Boolean @default(true)

  memberships Membership[]
  sessions    AuthSession[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  auditLogs       AuditLog[]
  sentInvitations InstituteInvitation[]
}

model Membership {
  id String @id @default(uuid())

  userId   String
  tenantId String

  role   InstituteRole
  status MembershipStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  tenantId         String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model TenantProfile {
  id       String @id @default(uuid())
  tenantId String @unique

  email    String?
  phone    String?
  address  String?
  website  String?
  country  String?
  timezone String?
  logoUrl  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())

  tenantId    String
  actorUserId String?

  action     String
  targetType String?
  targetId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model InstituteInvitation {
  id String @id @default(uuid())

  tenantId        String
  invitedByUserId String

  email     String
  firstName String
  lastName  String

  role   InstituteRole
  status InvitationStatus @default(PENDING)

  tokenHash String
  expiresAt DateTime

  acceptedAt DateTime?
  revokedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invitedBy User @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email, status])
  @@index([tenantId])
  @@index([invitedByUserId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}
